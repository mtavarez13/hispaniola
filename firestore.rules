rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
      match /history/{auditId} {
        allow read, write: if true;
      }
    }
    match /qik_invoices/{invoiceId} {
      allow read, write: if true;
    }
    match /qik_pool/{poolId} {
      allow read, write: if true;
    }
    match /qik_agents/{agentId} {
      allow read, write: if true;
    }
    match /qik_transactions/{txId} {
      allow read, write: if true;
    }
    match /partners/{partnerId} {
      allow read, write: if true;
    }
    match /partner_transfers/{transferId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
