rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'adminLevel', 'canAccessSettings', 'canManageAdmins',
          'primaryCurrency', 'benefitRatePercent', 'benefitAccruedDOP'
        ])
      );
      allow delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read, write: if true;
      match /history/{auditId} {
        allow read, write: if true;
      }
    }
    match /qik_invoices/{invoiceId} {
      allow read, write: if true;
    }
    match /qik_pool/{poolId} {
      allow read, write: if true;
    }
    match /qik_agents/{agentId} {
      allow read, write: if true;
    }
    match /qik_transactions/{txId} {
      allow read, write: if true;
    }
    match /partners/{partnerId} {
      allow read, write: if true;
    }
    match /partner_transfers/{transferId} {
      allow read, write: if true;
    }
    // Solo el backend con Firebase Admin puede leer o escribir estas colecciones.
    match /whatsapp_messages/{messageId} {
      allow read, write: if false;
    }
    match /whatsapp_delivery_status/{messageId} {
      allow read, write: if false;
    }
    match /server_config/{configId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
